<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.wso2.org.apache.commons</groupId>
    <artifactId>commons-vfs2-project</artifactId>
    <version>2.10.0-wso2v10-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <groupId>org.wso2.org.apache.commons</groupId>
  <artifactId>commons-vfs2-shared</artifactId>
  <packaging>jar</packaging>
  <name>Apache Commons VFS Shared</name>
  <description>Code that the file inbound and the file connector share, on top of the WSO2 fork of Apache Commons VFS.</description>

  <dependencies>
    <dependency>
      <groupId>org.wso2.org.apache.commons</groupId>
      <artifactId>commons-vfs2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.mwiede</groupId>
      <artifactId>jsch</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wso2.org.apache.commons</groupId>
      <artifactId>commons-vfs2-sandbox</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <commons.parent.dir>${basedir}/..</commons.parent.dir>
    <testpoints.excludedGroups>testbuild</testpoints.excludedGroups>
  </properties>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${testpoints.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>testbuild</id>
      <properties>
        <testpoints.excludedGroups />
      </properties>
    </profile>
  </profiles>
</project>
